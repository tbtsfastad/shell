#!/bin/bash
set -o pipefail

version=0.3.0

usage() {
  printf '%s\n' '用法 ts-and-cmd run [--debug] [-d 设备序列号]' \
    '     ts-and-cmd build <apk|appbundle> [--debug]' \
    '默认构建 Release，选择 adb devices 中第一台可用设备。' \
    '启动后持续输出应用日志。按 f 过滤日志，按 q 退出 App。'
}

fail() {
  printf 'ts-and-cmd %s: %s\n' "$command" "$1" >&2
  exit 1
}

argument_error() {
  printf 'ts-and-cmd: %s\n' "$1" >&2
  usage >&2
  exit 2
}

sdk_directory() {
  local sdk=''
  if [[ -f local.properties ]]; then
    sdk=$(/usr/bin/sed -nE 's/^[[:blank:]]*sdk\.dir[[:blank:]]*[=:][[:blank:]]*//p' local.properties | /usr/bin/tail -n 1) || return 1
  fi
  if [[ -n $sdk ]]; then
    printf '%s' "$sdk" | /usr/bin/perl -CS -pe 's/\\(?:u([0-9a-fA-F]{4})|(.))/defined($1) ? chr(hex($1)) : $2/ge'
  else
    printf '%s' "${ANDROID_HOME:-${ANDROID_SDK_ROOT:-$HOME/Library/Android/sdk}}"
  fi
}

select_device() {
  local output status serial requested=$1 found='未连接'
  output=$("$adb" devices) || fail '无法查询 ADB 设备'
  while IFS=$'\t' read -r serial status; do
    [[ -n $status ]] || continue
    status=${status%$'\r'}
    if [[ -z $requested && $status == device ]] || [[ $serial == "$requested" && $status == device ]]; then
      printf '%s' "$serial"
      return
    fi
    [[ $serial != "$requested" ]] || found=$status
  done <<< "$output"
  if [[ -n $requested ]]; then
    fail "设备 $requested 不可用（$found）"
  fi
  fail "ADB 没有可用设备。$output"
}

find_apk() {
  local variant=$1 mode=${2:-install} metadata directory names name
  directory="app/build/outputs/apk/$variant"
  metadata="$directory/output-metadata.json"
  [[ -f $metadata ]] || fail "找不到 APK 构建信息（${metadata}）"
  names=$(/usr/bin/perl -Mutf8 -MJSON::PP -CS -e '
    use strict;
    my ($path, $variant, $mode) = @ARGV;
    open my $file, "<:raw", $path or die "$!\n";
    local $/;
    my $data = decode_json(<$file>);
    ref($data) eq "HASH" && ref($data->{elements}) eq "ARRAY" or die "APK 构建信息格式无效\n";
    my $built_variant = $data->{variantName} // "";
    $built_variant eq $variant or die "构建变体为 $built_variant，预期为 $variant\n";

    my @artifacts = @{$data->{elements}};
    if ($mode eq "install") {
      @artifacts = grep { ref($_) eq "HASH" && ref($_->{filters}) eq "ARRAY" && !@{$_->{filters}} } @artifacts
        if @artifacts != 1;
      @artifacts == 1 or die "未找到唯一可安装的 APK\n";
    }
    @artifacts or die "未找到 APK 产物\n";
    for my $artifact (@artifacts) {
      ref($artifact) eq "HASH" && $artifact->{outputFile} or die "APK 构建信息格式无效\n";
      print "$artifact->{outputFile}\n";
    }
  ' "$metadata" "$variant" "$mode" 2>&1) || fail "无法从 ${metadata} 定位 APK。$names"
  while IFS= read -r name; do
    [[ -f $directory/$name ]] || fail "找不到 Gradle 生成的 APK（${directory}/${name}）"
    printf '%s\n' "$PWD/$directory/$name"
  done <<< "$names"
}

start_app() {
  local package=$1 resolved line component='' result activity
  local intent=(-a android.intent.action.MAIN -c android.intent.category.LAUNCHER)
  resolved=$("$adb" -s "$selected" shell cmd package resolve-activity --brief --user current "${intent[@]}" -p "$package" 2>&1) ||
    fail "无法解析 $package 的 Launcher Activity。$resolved"
  while IFS= read -r line; do
    line=${line%$'\r'}
    activity=${line#*/}
    if [[ $line == "$package/"* && $activity =~ ^[[:alnum:]_.$]+$ ]]; then
      component=$line
      break
    fi
  done <<< "$resolved"
  [[ -n $component ]] || fail "无法解析 $package 的 Launcher Activity。$resolved"

  printf '启动 %s\n' "$component"
  result=$("$adb" -s "$selected" shell am start -W --user current "${intent[@]}" -n "'$component'" 2>&1) || fail "$result"
  printf '%s\n' "$result" | /usr/bin/grep -Eq '^Status: ok[[:space:]]*$' || fail "启动失败。$result"
  printf '%s\n' "$result"
}

app_log_filter() {
  local package=$1 help packages name uid app_pid
  help=$("$adb" -s "$selected" logcat --help) || fail '无法查询 logcat 参数'
  if [[ $help == *--uid=* ]]; then
    packages=$("$adb" -s "$selected" shell cmd package list packages -U --user current "$package") ||
      fail "无法查询 $package 的应用 UID"
    while read -r name uid _; do
      uid=${uid%$'\r'}
      if [[ $name == "package:$package" && $uid =~ ^uid:[0-9]+$ ]]; then
        printf '%s' "--uid=${uid#uid:}"
        return
      fi
    done <<< "$packages"
    fail "找不到 $package 的应用 UID"
  fi

  app_pid=$("$adb" -s "$selected" shell pidof -s "$package") || fail "找不到 $package 的应用进程"
  app_pid=${app_pid%$'\r'}
  [[ $app_pid =~ ^[1-9][0-9]*$ ]] || fail "找不到 $package 的应用进程"
  printf '%s' "--pid=$app_pid"
}

command=${1:-}
task_prefix=assemble
case $command in
  --version)
    [[ $# == 1 ]] || argument_error '--version 不接受其他参数'
    printf 'ts-and-cmd %s\n' "$version"
    exit 0
    ;;
  -h|--help) usage; exit 0 ;;
  run) shift ;;
  build)
    shift
    case ${1:-} in
      -h|--help) usage; exit 0 ;;
      apk) ;;
      appbundle) task_prefix=bundle ;;
      *) argument_error '请指定构建目标 apk 或 appbundle' ;;
    esac
    shift
    ;;
  *) argument_error '请输入 run 或 build 子命令' ;;
esac

variant=release
build_type=Release
requested=''
while (($#)); do
  case $1 in
    -h|--help) usage; exit 0 ;;
    --debug) variant=debug; build_type=Debug ;;
    -d)
      [[ $command == run ]] || argument_error "未知参数 $1"
      [[ $# -ge 2 && -n $2 && $2 != -* ]] || argument_error '请提供 ADB 设备序列号'
      [[ -z $requested ]] || argument_error '设备序列号只能指定一次'
      requested=$2
      shift
      ;;
    *) argument_error "未知参数 $1" ;;
  esac
  shift
done
task=":app:${task_prefix}${build_type}"

[[ -f gradlew ]] || fail '请在包含 gradlew 的 Android 工程根目录运行'
sdk=$(sdk_directory) || fail '无法读取 local.properties 中的 sdk.dir'
[[ -d $sdk ]] || fail "找不到 Android SDK（$sdk），请检查 sdk.dir 或 ANDROID_HOME"
if [[ $command == run ]]; then
  adb="$sdk/platform-tools/adb"
  [[ -x $adb ]] || fail "找不到 adb，请在 $sdk 安装 Android SDK Platform Tools"
  selected=$(select_device "$requested") || exit 1

  aapt2=''
  for tool in "$sdk"/build-tools/*/aapt2; do
    [[ ! -x $tool ]] || aapt2=$tool
  done
  [[ -n $aapt2 ]] || fail "找不到 aapt2，请在 $sdk 安装 Android SDK Build Tools"
fi

export ANDROID_HOME="$sdk"
[[ -z ${ANDROID_SDK_ROOT+x} ]] || export ANDROID_SDK_ROOT="$sdk"
if [[ -z ${JAVA_HOME:-} ]]; then
  java=$(command -v java)
  if [[ -z $java ]] || { [[ $java == /usr/bin/java ]] && ! /usr/libexec/java_home -F >/dev/null 2>&1; }; then
    studio_jdk='/Applications/Android Studio.app/Contents/jbr/Contents/Home'
    [[ -x $studio_jdk/bin/java ]] || fail '找不到可用的 JDK，请设置 JAVA_HOME 指向工程所需的 JDK'
    export JAVA_HOME="$studio_jdk"
  fi
fi

if [[ $command == run ]]; then
  printf '设备 %s，构建 %s\n' "$selected" "$task"
else
  printf '构建 %s\n' "$task"
fi
if [[ -x gradlew ]]; then
  ./gradlew "$task" || fail 'Gradle 构建失败'
else
  /bin/sh ./gradlew "$task" || fail 'Gradle 构建失败'
fi
if [[ $command == build ]]; then
  if [[ $task_prefix == assemble ]]; then
    artifacts=$(find_apk "$variant" all) || exit 1
    while IFS= read -r artifact; do
      printf '构建产物 %s\n' "$artifact"
    done <<< "$artifacts"
  else
    directory="$PWD/app/build/outputs/bundle/$variant"
    artifacts=("$directory"/*.aab)
    [[ -f ${artifacts[0]} ]] || fail "找不到 Gradle 生成的 AAB（${directory}）"
    for artifact in "${artifacts[@]}"; do
      [[ ! -f $artifact ]] || printf '构建产物 %s\n' "$artifact"
    done
  fi
  exit 0
fi

apk=$(find_apk "$variant") || exit 1
badging=$("$aapt2" dump badging "$apk") || fail "无法读取 APK（$apk）"
package=$(printf '%s\n' "$badging" | /usr/bin/sed -nE "s/^package: name='([A-Za-z][A-Za-z0-9_]*(\.[A-Za-z][A-Za-z0-9_]*)+)'.*/\1/p")
[[ -n $package ]] || fail "无法从 APK 读取 applicationId（$apk）"

printf '安装 %s → %s\n' "$package" "$selected"
"$adb" -s "$selected" install -r "$apk" || fail 'APK 安装失败'
log_start=$("$adb" -s "$selected" shell date +%s) || log_start=''
log_start=${log_start%$'\r'}
start_app "$package"

filter=$(app_log_filter "$package") || exit 1
if [[ $log_start =~ ^[0-9]+$ ]]; then log_start="${log_start}.000"; else log_start=1; fi
log_args=(-s "$selected" logcat -v threadtime -T "$log_start" "$filter")
if [[ ! -t 0 ]] || ! terminal_state=$(/bin/stty -g 2>/dev/null); then
  printf '正在输出 %s 的日志。\n' "$package"
  exec "$adb" "${log_args[@]}"
fi

printf '正在输出 %s 的日志。按 f 过滤日志，按 q 退出 App。\n' "$package"
rules=$(mktemp) || fail '无法创建日志过滤文件'
log_pid=''
trap '
  /bin/stty "$terminal_state" 2>/dev/null
  if [[ -n $log_pid ]]; then
    kill "$log_pid" 2>/dev/null
    wait "$log_pid" 2>/dev/null
  fi
  rm -f -- "$rules"
' EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
redraw=0
[[ ! -t 1 ]] || redraw=1
/usr/bin/perl -CSD -Mutf8 -MEncode -MIO::Select -MTime::HiRes -e '
  my $rules = shift;
  my $redraw = shift;
  $| = 1;
  my $pid = open my $logs, "-|", @ARGV;
  defined $pid or die "logcat: $!\n";
  binmode $logs, ":raw";
  my $ready = IO::Select->new($logs);
  my $buffer = "";
  my @history;
  my @words;
  my $revision = "";
  for my $signal (qw(INT TERM HUP)) {
    $SIG{$signal} = sub { kill "TERM", $pid; close $logs; exit 130; };
  }
  sub show_log {
    my ($line) = @_;
    my $text = $line;
    $text =~ s/^\d{2}-\d{2}\s+\d{2}:\d{2}:\d{2}\.\d+\s+\d+\s+\d+\s+[VDIWEFA]\s+//;
    print $line unless grep { index($text, $_) >= 0 } @words;
  }
  while (1) {
    my @info = Time::HiRes::stat($rules);
    my $changed = "$info[7]:$info[9]";
    if ($changed ne $revision) {
      open my $input, "<:encoding(UTF-8)", $rules or die "$rules: $!\n";
      @words = <$input>;
      chomp @words;
      if ($revision ne "" || @words) {
        if ($redraw) {
          print "\e[H\e[2J\e[3J";
          show_log($_) for @history;
        }
        print @words ? "日志过滤已更新。\n" : "已清除日志关键词过滤。\n";
      }
      $revision = $changed;
    }
    next unless $ready->can_read(0.1);
    my $length = sysread($logs, my $chunk, 8192);
    if (!defined $length) {
      next if $!{EINTR};
      die "logcat: $!\n";
    }
    last if $length == 0;
    $buffer .= $chunk;
    while ($buffer =~ s/\A([^\n]*\n)//) {
      my $line = Encode::decode("UTF-8", $1);
      push @history, $line if $redraw;
      show_log($line);
    }
  }
  show_log(Encode::decode("UTF-8", $buffer)) if length $buffer;
  close $logs;
  exit(($? & 127) ? 128 + ($? & 127) : $? >> 8);
' -- "$rules" "$redraw" "$adb" "${log_args[@]}" </dev/null &
log_pid=$!

quoted_word='^-w[[:blank:]]+"([^"]+)"[[:blank:]]*$'
plain_word='^-w[[:blank:]]+([^[:blank:]"]+)[[:blank:]]*$'
while kill -0 "$log_pid" 2>/dev/null; do
  IFS= read -rsn 1 -t 1 key || continue
  case $key in
    f)
      IFS= read -er -p 'f ' input || continue
      input="${input#"${input%%[![:blank:]]*}"}"
      if [[ $input =~ $quoted_word || $input =~ $plain_word ]]; then
        word="${BASH_REMATCH[1]}"
        printf '%s\n' "$word" >> "$rules"
      elif [[ $input =~ ^-c[[:blank:]]*$ ]]; then
        : > "$rules"
      else
        printf '%s\n' '用法 f -w "关键词" 或 f -c'
      fi
      ;;
    q)
      "$adb" -s "$selected" shell am force-stop --user current "$package" || fail "无法退出 $package"
      exit 0
      ;;
  esac
done

wait "$log_pid"
log_status=$?
log_pid=''
exit "$log_status"
