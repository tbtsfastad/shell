#!/bin/bash

# Read the entire script before making changes when launched with bash <(curl ...).
{
set +x
set -euo pipefail
umask 077

fail() {
  printf '%s\n' "$*" >&2
  exit 1
}

case "$OSTYPE" in
  darwin*) ;;
  *) fail '此脚本仅适用于 macOS。' ;;
esac

if [[ $# -ne 0 ]]; then
  fail '请直接运行脚本，并在菜单中选择操作。'
fi

printf '%s\n' 'Kimi K3.1 Pro · Codex（macOS）' '1) 安装配置' '9) 恢复安装前的配置' '0) 退出'
printf '请选择 [1/9/0]：' >&2
IFS= read -r action || fail '未读取到选项。'
case "$action" in
  1|9) ;;
  0) exit 0 ;;
  *) fail '请选择 1、9 或 0。' ;;
esac

if [[ "$action" == 1 ]]; then
  printf '\n请输入 Kimi API Key（输入不回显）：' >&2
  IFS= read -rs token || fail '未读取到 API Key。'
  printf '\n' >&2
  if [[ ! "$token" =~ ^[A-Za-z0-9._~+/-]+=*$ ]]; then
    fail 'API Key 为空或含有无效字符。'
  fi
fi

codex_dir="${CODEX_HOME:-$HOME/.codex}"
if [[ "$codex_dir" != /* ]]; then
  codex_dir="$PWD/$codex_dir"
fi
config="$codex_dir/config.toml"
backup="$codex_dir/backup-kimi"
lock="$codex_dir/.kimi-setup.lock"

mkdir -p "$codex_dir"
mkdir "$lock" 2>/dev/null || fail "无法锁定配置目录：$lock"
trap 'rm -f "$lock/config.toml" "$lock/original.toml" "$lock/kimi-models.json" "$lock/kimi-api-models.json"; rmdir "$lock"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

if [[ -L "$config" || ( -e "$config" && ! -f "$config" ) ]]; then
  fail "配置路径必须是普通文件：$config"
fi
if [[ -L "$backup" || ( -e "$backup" && ! -d "$backup" ) ]]; then
  fail "备份路径必须是目录：$backup"
fi

if [[ "$action" == 9 ]]; then
  if [[ -f "$backup/config.toml" ]]; then
    cp "$backup/config.toml" "$lock/config.toml"
    mv -f "$lock/config.toml" "$config"
    printf '已恢复配置：%s\n' "$config"
  elif [[ -f "$backup/no-config" ]]; then
    rm -f "$config"
    printf '%s\n' '已恢复到安装前没有 config.toml 的状态。'
  else
    fail "找不到可用备份：$backup"
  fi
  printf '%s\n' '使用桌面端时，请按 ⌘Q 完全退出应用，再重新打开。'
  exit 0
fi

catalog="$codex_dir/codex-setup-kimi-models.json"
if [[ -L "$catalog" || ( -e "$catalog" && ! -f "$catalog" ) ]]; then
  fail "模型目录路径必须是普通文件：$catalog"
fi
if [[ "$catalog" =~ [[:cntrl:]] ]]; then
  fail 'CODEX_HOME 路径不能含有控制字符。'
fi
if ! printf 'Authorization: Bearer %s\n' "$token" | /usr/bin/curl -fsS --max-time 20 --header @- 'https://api.moonshot.cn/v1/models' -o "$lock/kimi-api-models.json"; then
  fail '无法获取 Kimi 模型列表，请检查 API Key 和网络。'
fi

# Kimi returns a generic data array. Build the Codex catalog from the Responses-compatible entries.
catalog_selection=$(/usr/bin/osascript -l JavaScript - "$lock/kimi-api-models.json" "$lock/kimi-models.json" <<'KIMI_CATALOG_JS'
ObjC.import('Foundation');

function run(argv) {
  var input = $.NSString.stringWithContentsOfFileEncodingError(argv[0], $.NSUTF8StringEncoding, null);
  var response = JSON.parse(ObjC.unwrap(input));
  if (!Array.isArray(response.data)) {
    throw new Error('Kimi 模型列表格式无效。');
  }

  var supported = [
    ['kimi-k3.1-pro', 'Kimi K3.1 Pro'],
    ['kimi-k3', 'Kimi K3'],
    ['kimi-k3.1-pro-highspeed', 'Kimi K3.1 Pro Highspeed']
  ];
  var models = [];
  supported.forEach(function (entry) {
    var available = response.data.filter(function (model) { return model && model.id === entry[0]; })[0];
    if (!available) return;
    var context = available.context_length;
    if (!Number.isSafeInteger(context) || context <= 0) context = 1048576;
    models.push({
      slug: entry[0],
      display_name: entry[1],
      default_reasoning_level: 'max',
      supported_reasoning_levels: [
        { effort: 'low', description: 'Low reasoning effort' },
        { effort: 'high', description: 'High reasoning effort' },
        { effort: 'max', description: 'Maximum reasoning effort' }
      ],
      shell_type: 'shell_command',
      visibility: 'list',
      supported_in_api: true,
      priority: models.length + 1,
      support_verbosity: false,
      supports_reasoning_summary_parameter: false,
      truncation_policy: { mode: 'tokens', limit: 10000 },
      context_window: context,
      max_context_window: context,
      experimental_supported_tools: [],
      input_modalities: available.supports_image_in === false ? ['text'] : ['text', 'image'],
      supports_search_tool: true
    });
  });
  if (!models.length) throw new Error('当前 API Key 没有可用的 Kimi Responses 模型。');
  var json = $(JSON.stringify({ models: models }));
  if (!json.writeToFileAtomicallyEncodingError(argv[1], true, $.NSUTF8StringEncoding, null)) {
    throw new Error('无法保存 Kimi 模型目录。');
  }
  return models[0].slug + ' ' + models[0].context_window;
}
KIMI_CATALOG_JS
) || fail '无法生成 Kimi 模型目录，原配置未替换。'
IFS=' ' read -r kimi_model kimi_context <<< "$catalog_selection"
catalog_toml=${catalog//\\/\\\\}
catalog_toml=${catalog_toml//\"/\\\"}
cat > "$lock/config.toml" <<EOF
model = "$kimi_model"
model_provider = "kimi"
model_context_window = $kimi_context
model_catalog_json = "$catalog_toml"

[model_providers.kimi]
name = "Kimi"
base_url = "https://api.moonshot.cn/v1"
env_key = "KIMI_API_KEY"
wire_api = "responses"
EOF

if [[ ! -f "$backup/config.toml" && ! -f "$backup/no-config" ]]; then
  mkdir -p "$backup"
  if [[ -f "$config" ]]; then
    cp "$config" "$lock/original.toml"
    mv "$lock/original.toml" "$backup/config.toml"
  else
    : > "$backup/no-config"
  fi
fi

mv -f "$lock/kimi-models.json" "$catalog"
/bin/launchctl setenv KIMI_API_KEY "$token"
unset token
mv -f "$lock/config.toml" "$config"
printf '已写入配置：%s\n首次安装前的配置备份：%s\n' "$config" "$backup"
printf '%s\n' '使用桌面端时，请按 ⌘Q 完全退出应用，再重新打开。'
printf '%s\n' '在已打开的终端使用 CLI 前，请运行：' 'export KIMI_API_KEY="$(launchctl getenv KIMI_API_KEY)"'
exit 0
}
