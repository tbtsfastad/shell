#!/bin/bash
set -eu

command_url='https://raw.githubusercontent.com/tbtsfastad/shell/main/ts-and-cmd-mac'
# Update the checksum in the same commit as changes to ts-and-cmd-mac.
command_sha256='251bd368fc3943a1b2e2e9d9299bc5d8ed530054cbf7302f934c4f54c147c983'
path_setting='case "$PATH:" in "$HOME/.local/share/ts-and-cmd/bin:"*) ;; *) export PATH="$HOME/.local/share/ts-and-cmd/bin:$PATH" ;; esac'

fail() {
  printf 'ts-and-cmd-setup-mac: %s\n' "$1" >&2
  exit 1
}

shell=${SHELL:-/bin/zsh}
case ${shell##*/} in
  zsh) profile="${ZDOTDIR:-$HOME}/.zshrc" ;;
  bash)
    profile="$HOME/.bash_profile"
    for candidate in "$HOME/.bash_profile" "$HOME/.bash_login" "$HOME/.profile"; do
      if [[ -f $candidate ]]; then
        profile=$candidate
        break
      fi
    done
    ;;
  *) fail "安装需要 macOS 的 zsh 或 Bash，当前 shell 为 $shell" ;;
esac

install_root="$HOME/.local/share/ts-and-cmd"
destination="$install_root/bin/ts-and-cmd"
mkdir -p -- "${destination%/*}"
staging="$install_root/.installing"
mkdir -- "$staging" || fail "无法创建安装目录（${staging}）"
trap 'rm -f -- "$staging/ts-and-cmd"; rmdir -- "$staging"' EXIT
trap 'exit 1' HUP INT TERM

/usr/bin/curl -fsSL "$command_url" -o "$staging/ts-and-cmd" || fail '下载 ts-and-cmd 失败'
checksum=$(/usr/bin/shasum -a 256 "$staging/ts-and-cmd")
[[ ${checksum%% *} == "$command_sha256" ]] || fail 'ts-and-cmd 下载文件的校验值不匹配，请重新运行安装命令'
chmod 755 "$staging/ts-and-cmd"

[[ ! -d $destination ]] || fail "目标路径是目录（${destination}）"
: >> "$profile" || fail "无法写入 shell 配置（${profile}）"
mv -f -- "$staging/ts-and-cmd" "$destination" || fail "无法安装到 $destination"
if /usr/bin/grep -Fxq -- "$path_setting" "$profile"; then
  :
elif [[ $? == 1 ]]; then
  printf '\n# ts-and-cmd\n%s\n' "$path_setting" >> "$profile" || fail "无法写入 shell 配置（${profile}）"
else
  fail "无法读取 shell 配置（${profile}）"
fi

printf '已安装 %s\n已配置 %s\n' "$destination" "$profile"
