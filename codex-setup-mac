#!/bin/bash

# Read the entire script before making changes when launched with bash <(curl ...).
{
set +x
set -euo pipefail
umask 077

fail() {
  printf '%s\n' "$*" >&2
  exit 1
}

case "$OSTYPE" in
  darwin*) ;;
  *) fail '此脚本仅适用于 macOS。' ;;
esac

if [[ $# -ne 0 ]]; then
  fail '请直接运行脚本，并在菜单中选择操作。'
fi

printf '%s\n' 'Codex 配置管理（macOS）' '1) 配置' '2) 恢复' '3) 退出'
printf '请选择 [1/2/3]：' >&2
IFS= read -r action || fail '未读取到选项。'
case "$action" in
  1|2) ;;
  3) exit 0 ;;
  *) fail '请选择 1、2 或 3。' ;;
esac

if [[ "$action" == 1 ]]; then
  printf '\n%s\n' '请选择服务商' '1) TB-GPT' '2) 腾讯 Hy4 · TokenHub' '3) 腾讯 Hy4 · Token Plan' '4) Kimi' '0) 退出'
  printf '请选择 [1/2/3/4/0]：' >&2
  IFS= read -r selection || fail '未读取到选项。'
  key_name=''
  case "$selection" in
    1)
      selection_name="TB-GPT"
      ;;
    2)
      selection_name="腾讯 Hy4 · TokenHub"
      provider="hy4-tokenhub"
      provider_name="Hy4 via tokenhub"
      base_url="https://tokenhub.tencentmaas.com/v1"
      key_name="HY4_API_KEY"
      ;;
    3)
      selection_name="腾讯 Hy4 · Token Plan"
      provider="hy4-tokenplan"
      provider_name="Hy4 via Token Plan"
      base_url="https://tokenhub.tencentmaas.com/plan/v3"
      key_name="HY4_API_KEY"
      ;;
    4)
      selection_name="Kimi"
      key_name="KIMI_API_KEY"
      ;;
    0) exit 0 ;;
    *) fail '请选择 1、2、3、4 或 0。' ;;
  esac
fi

codex_dir="${CODEX_HOME:-$HOME/.codex}"
if [[ "$codex_dir" != /* ]]; then
  codex_dir="$PWD/$codex_dir"
fi
config="$codex_dir/config.toml"
backup="$codex_dir/backup-codex-setup"
lock="$codex_dir/.codex-setup.lock"

catalog="$backup/hy4-models.json"
catalog_url="https://hy-model-ap-prod-1258344703.cos.accelerate.myqcloud.com/public/hy4/files/zh/k7ou_codex/models.json"
catalog_sha="dad5abf251056f107f17579d08e0c415cc724b0624dba99b8682dee69d41dc2f"

if [[ "$action" == 1 ]]; then
  mkdir -p "$codex_dir"
elif [[ ! -d "$codex_dir" ]]; then
  fail "找不到可用备份：$backup"
fi
mkdir "$lock" 2>/dev/null || fail "无法锁定配置目录：$lock"
trap 'rm -f "$lock/config.toml" "$lock/original.toml" "$lock/models.json"; rmdir "$lock"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

if [[ -L "$config" || ( -e "$config" && ! -f "$config" ) ]]; then
  fail "配置路径必须是普通文件：$config"
fi
if [[ -L "$backup" || ( -e "$backup" && ! -d "$backup" ) ]]; then
  fail "备份路径必须是目录：$backup"
fi
for backup_file in "$backup/config.toml" "$backup/no-config"; do
  if [[ -L "$backup_file" || ( -e "$backup_file" && ! -f "$backup_file" ) ]]; then
    fail "备份路径必须是普通文件：$backup_file"
  fi
done
if [[ "$action" == 2 ]]; then
  if [[ -f "$backup/config.toml" ]]; then
    cp "$backup/config.toml" "$lock/config.toml"
    mv -f "$lock/config.toml" "$config"
    printf '已恢复配置：%s\n' "$config"
  elif [[ -f "$backup/no-config" ]]; then
    rm -f "$config"
    printf '%s\n' '已恢复到安装前没有 config.toml 的状态。'
  else
    fail "找不到可用备份：$backup"
  fi
  printf '%s\n' '使用桌面端时，请按 ⌘Q 完全退出应用，再重新打开。'
  exit 0
fi

backup_choice=1
if [[ -d "$backup" ]]; then
  if [[ -f "$backup/config.toml" || -f "$backup/no-config" ]]; then
    printf '\n已有备份：%s\n' "$backup"
  else
    printf '\n备份目录已存在，但没有可用备份：%s\n' "$backup"
  fi
  printf '%s\n' '1) 用当前配置替换备份' '2) 忽略，保留现有备份'
  printf '请选择 [1/2]：' >&2
  IFS= read -r backup_choice || fail '未读取到备份选项。'
  case "$backup_choice" in
    1|2) ;;
    *) fail '请选择 1 或 2。' ;;
  esac
fi

if [[ "$selection" == 4 ]]; then
  printf '\n请输入 %s API Key（输入不回显）：' "$selection_name" >&2
  IFS= read -rs token || fail '未读取到 API Key。'
  printf '\n' >&2
else
  printf '\n请输入 %s API Key（输入内容会显示）：' "$selection_name" >&2
  IFS= read -r token || fail '未读取到 API Key。'
fi
if [[ ! "$token" =~ ^[A-Za-z0-9._~+/-]+=*$ ]]; then
  fail 'API Key 为空或含有无效字符。'
fi

case "$selection" in
  1)
    cat > "$lock/config.toml" <<EOF
model_provider = "OpenAI"
model = "gpt-6.1-sol"
review_model = "gpt-6.1-sol"
web_search = "live"
disable_response_storage = true
network_access = "enabled"

[model_providers.OpenAI]
name = "OpenAI"
base_url = "https://g.ccexx.com/v1"
model_catalog_url = "https://g.ccexx.com/v1/models"
wire_api = "responses"
requires_openai_auth = false
experimental_bearer_token = "$token"
http_headers = { "x-openai-actor-authorization" = "local-image-extension" }

[features]
api_key_model_discovery = true
image_generation = true
goals = true
EOF
    ;;
  2|3)
    if [[ -L "$catalog" || ( -e "$catalog" && ! -f "$catalog" ) ]]; then
      fail "模型目录路径必须是普通文件：$catalog"
    fi

    /usr/bin/curl -fsSL "$catalog_url" -o "$lock/models.json"
    if ! (cd "$lock" && printf '%s  models.json\n' "$catalog_sha" | /usr/bin/shasum -a 256 -c --status); then
      fail '腾讯官方模型目录的校验值已变化，请更新安装脚本后重试。'
    fi

    if [[ "$catalog" =~ [[:cntrl:]] ]]; then
      fail 'CODEX_HOME 路径不能含有控制字符。'
    fi
    catalog_toml=${catalog//\\/\\\\}
    catalog_toml=${catalog_toml//\"/\\\"}
    cat > "$lock/config.toml" <<EOF
model_provider = "$provider"
model = "hy4"
model_catalog_json = "$catalog_toml"
web_search = "disabled"
model_reasoning_effort = "high"

[model_providers.$provider]
name = "$provider_name"
base_url = "$base_url"
env_key = "HY4_API_KEY"
wire_api = "responses"
EOF
    ;;
  4)
    cat > "$lock/config.toml" <<'EOF'
model = "kimi-k3.1-pro"
model_provider = "kimi"
model_context_window = 1048576

[model_providers.kimi]
name = "Kimi"
base_url = "https://api.moonshot.cn/v1"
env_key = "KIMI_API_KEY"
wire_api = "responses"
EOF
    ;;
esac

if [[ "$backup_choice" == 1 ]]; then
  mkdir -p "$backup"
  if [[ -f "$config" ]]; then
    cp "$config" "$lock/original.toml"
    mv "$lock/original.toml" "$backup/config.toml"
    rm -f "$backup/no-config"
  else
    : > "$backup/no-config"
    rm -f "$backup/config.toml"
  fi
fi

if [[ "$selection" == 2 || "$selection" == 3 ]]; then
  mv -f "$lock/models.json" "$catalog"
fi
if [[ -n "${key_name:-}" ]]; then
  /bin/launchctl setenv "$key_name" "$token"
fi
unset token
mv -f "$lock/config.toml" "$config"
printf '已配置 %s：%s\n备份目录：%s\n' "$selection_name" "$config" "$backup"
printf '%s\n' '使用桌面端时，请按 ⌘Q 完全退出应用，再重新打开。'
if [[ -n "${key_name:-}" ]]; then
  printf '使用 CLI 前，请在同一个终端运行：\nexport %s="$(launchctl getenv %s)"\n' "$key_name" "$key_name"
fi
exit 0
}
